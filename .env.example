# Cloud Clipboard Go - 环境变量配置
# 复制此文件为 .env 并修改对应值

# ========== 服务器配置 ==========
# 服务器监听地址，默认为 0.0.0.0
LISTEN_IP=

# IPv6 地址，默认为空，可设置为 ::
LISTEN_IP6=

# 服务器监听端口，默认为 9501
LISTEN_PORT=9501

# 子路径，可配合 nginx 使用，格式: /cloud-clipboard
PREFIX=

# ========== 功能配置 ==========
# 历史记录的数量，默认为 10
MESSAGE_NUM=10

# 是否启用房间列表展示功能，默认 false
ROOM_LIST=false

# ========== 认证配置 ==========
# 访问密码，默认为空（不启用密码）
AUTH_PASSWORD=

# 房间密码 JSON，值为字符串或对象
# 格式: {"房间名":"密码","房间名":{"password":"密码","fileExpire":0},"房间名":{"fileExpire":604800}}
# fileExpire: 0=文件永不过期，>0=覆盖 FILE_EXPIRE 秒数
ROOM_AUTH_JSON={}

# ========== 限制配置 ==========
# 文本长度限制，默认为 4096 (2048 个汉字)
TEXT_LIMIT=4096

# 文件过期时间，默认为 3600 (1 小时)，单位为秒
FILE_EXPIRE=3600

# 文件大小限制，默认为 104857600 (100MB)，单位为字节
FILE_LIMIT=104857600

# ========== SSL/TLS 证书配置 ==========
# mkcert 域名或 IP，默认为空，多个用空格分隔，仅域名支持通配符 *
MKCERT_DOMAIN_OR_IP=

# 手动设置证书路径，优先级高于 MKCERT_DOMAIN_OR_IP
MANUAL_KEY_PATH=

# 手动设置证书路径，优先级高于 MKCERT_DOMAIN_OR_IP
MANUAL_CERT_PATH=
