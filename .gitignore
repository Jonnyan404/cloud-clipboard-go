# build caches / local artifacts
/.vite/
/cloud-clip/cloud-clipboard-go-embed

# 分享记录的运行时落盘：和 history.json 同类 —— 服务自己会重建，不入库。
/cloud-clip/share-log.json

# 定时任务（tasks.json）：同样是与 history.json 同目录的运行时落盘。
# 和 share-log.json 一样，它由服务自己维护，不入库 —— 里面是各人自己配的任务。
/cloud-clip/tasks.json

# 本地工具的项目标记
/.freebuff/

# 网页端的捷径下载目录：由 web-vue3/scripts/sync-shortcuts.mjs 从 shortcuts/ 生成，
# 是派生产物 —— 唯一源仍是 shortcuts/ 下那几份，别把副本入库。
/web-vue3/public/shortcuts/

# Python
__pycache__/
*.py[cod]

# Apple 快捷指令：source/ 只放源码与后处理脚本，产物一律在 shortcuts/apple/ 下。
# 这里连签名产物也一并忽略——build.sh 曾把签名结果先写进 source/ 再 cp 上去，
# 留下同字节副本，让人分不清该导入哪个。
/shortcuts/apple/source/*.shortcut
/shortcuts/apple/source/*.plist

# Android 快捷指令：shortcuts.json 是 HTTP Shortcuts 的**原始导出**，也是唯一源。
# 改捷径在应用里改、再导出丢回来，build.py 负责自检 + 换掉你自己的值 + 打包。
# 它带着导出者的服务器地址和明文密码（auth 变量的 value）—— 只作本地中间产物；
# 入库的是把这两项换成占位的 shortcuts.zip。
# ⚠️ 不要再往这个目录加第二份「同内容的东西」（shortcuts.js 那条路试过两次，都否了）。
/shortcuts/android/shortcuts.json

# 本地 AI 工作数据（项目记忆，不入库）
/.workbuddy-ai/
# ⚠️ 隔壁这个目录是**另一个工具**的工作目录（含它自己的 handover/ 与 memory/），
# 同样只在本机有意义 —— 2026-09-24 发现它一直没被忽略。
/.workbuddy/
.freebuff/
