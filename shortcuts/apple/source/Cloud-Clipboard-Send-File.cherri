// 发送【文件 / 图片】。与「发送文本」拆开 —— 判型交给用户，客户端不做任何类型判断。
//
// 为什么拆：剪贴板条目的名字反映的是**剪贴板格式**而非内容，客户端没法可靠判型；
// 而用户自己知道发的是什么。拆开之后服务端的 /upload/raw 可以整个删掉。
//
// 本捷径做的事：把条目作为 multipart 表单的「文件」字段 POST 到 /upload。
// 服务端用 part 自带的真实文件名（含扩展名）——**扩展名不需要猜**，
// 这也是唯一能保住 .md / .sh 这类扩展名的方式（getName 会把扩展名剥掉）。
#define name Cloud-Clipboard-Send-File
#define inputs file, image, text, url, pdf
#define from sharesheet,quickactions,menubar
#define noinput getclipboard
#define color blue
#define version 26

#include 'actions/web'
#include 'actions/text'
#include 'actions/sharing'
// getDeviceDetail 在 actions/device 里，用来判断当前平台（决定给通知还是给振动）
#include 'actions/device'

#question qServerURL "服务器地址，例如 https://clip.example.com 或 http://127.0.0.1:9501" "http://127.0.0.1:9501"
#question qRoomName "房间名，多设备接收同一内容时使用相同房间；默认填 default" "default"
#question qRoomPassword "全局访问密码或房间密码；未设密码则留空" ""

@endpoint = text(qServerURL)
@room = text(qRoomName)
@password = text(qRoomPassword)
@endpoint = replaceText('^\s+|\s+$', '', @endpoint, true, true)
@endpoint = replaceText('/+$', "", @endpoint, true, true)
@room = replaceText('^\s+|\s+$', '', @room, true, true)
if !@room { @room = "default" }
if !@endpoint {
    alert("请先编辑快捷指令顶部的部署地址、房间名和密码。")
    stop()
}
@encodedRoom = urlEncode(@room)

@source = ShortcutInput
if !@source { @source = getClipboard() }
@amount = count(@source)
if @amount != 1 {
    alert("请复制一个文件或图片后运行，或从分享菜单发送一个文件/一张照片。每次发送一项。")
    stop()
}
@item = getFirstItem(@source)

// multipart 表单上传。字段名必须是 file（服务端 r.FormFile("file") / formData.get("file") 认这个）。
// 字段类型必须是「文件」（WFItemType=5）—— cherri 的字典只能生成 text token，表达不了，
// 所以这里用字面量占位，由 source/patch_shortcut.py 构建后改造并指向 @item。
// 漏掉 WFItemType=5 会让服务端报「无法解析表单数据」。
@uploadURL = "{@endpoint}/upload?room={@encodedRoom}&client=ios-shortcuts"
@response = formRequest(@uploadURL, "POST", {"file": "PLACEHOLDER"}, {"Authorization":"Bearer {@password}"})

@record = getDictionary(@response)
@error = getValue(@record, "error")
if @error {
    @message = getValue(@record, "message")
    alert("发送失败：{@error}\n{@message}")
    stop()
}
@savedID = getValue(@record, "id")
if !@savedID {
    alert("服务器未确认保存，请检查部署地址及服务器状态。")
    stop()
}
// 反馈：通知 + 振动。
//
// **通知两个平台都要发**，不能像 Receive 那样按平台二选一 —— 通知里带的是 ID，
// 而 ID 是「按 ID 接收」唯一的信息来源（见 README「怎么用」）。iOS 上省掉通知
// 就等于让人拿不到 ID。
//
// 振动是 **iOS 专属**动作（cherri 文档明写），macOS 上根本不存在，必须用 @model 守卫。
// 顺带说明为何用通知而不是 show()：show() 会在屏幕中央弹结果卡片打断视线。
@modelName = getDeviceDetail('Device Model')
@model = getText(@modelName)
if @model != "Mac" {
    vibrate()
}
showNotification("已发送 {@savedID}", "Cloud Clipboard", false)
