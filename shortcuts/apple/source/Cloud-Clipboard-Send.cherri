#define name Cloud-Clipboard-Send
#define inputs file, image, text, url, pdf
#define from sharesheet
#define noinput getclipboard
#define color blue
#define version 26

#include 'actions/web'
#include 'actions/text'
#include 'actions/sharing'
#include 'actions/device'

// 导入时填写配置（也可之后在快捷指令顶部"文本"动作中修改）
#question qServerURL "服务器地址，例如 https://clip.example.com 或 http://127.0.0.1:9501" "http://127.0.0.1:9501"
#question qRoomName "房间名，多设备接收同一内容时使用相同房间；默认填 default" "default"
#question qRoomPassword "全局访问密码或房间密码；未设密码则留空" ""

// The server sniffs the payload and stores text as a text message, everything else as a file.
// No client-side type detection: macOS getImages/getText cannot tell text apart from images.
action 'downloadurl' rawUpload(text url: 'WFURL', variable body: 'WFRequestVariable', dictionary! headers: 'WFHTTPHeaders') {
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File"
}

@endpoint = text(qServerURL)
@room = text(qRoomName)
@password = text(qRoomPassword)
@endpoint = replaceText('^\s+|\s+$', '', @endpoint, true, true)
@endpoint = replaceText('/+$', "", @endpoint, true, true)
@room = replaceText('^\s+|\s+$', '', @room, true, true)
if !@room { @room = "default" }
if !@endpoint {
    alert("请先编辑快捷指令顶部的部署地址、房间名和密码。")
    stop()
}
@encodedRoom = urlEncode(@room)
@authorization = "Bearer {@password}"
@fromInput = ShortcutInput
@source = ShortcutInput
if !@source { @source = getClipboard() }
@amount = count(@source)
if @amount != 1 {
    alert("请复制一条文字或一张图片后运行，或从分享菜单发送一个文件/一张照片。每次发送一项。")
    stop()
}
@item = getFirstItem(@source)
@itemType = typeOf(@item)
@lt = lowercase(@itemType)
@fileMark = "no"
if @lt == "图像" || @lt == "image" || @lt == "图片" || @lt == "照片" || @lt == "photo" || @lt == "文件" || @lt == "file" || @lt == "文件夹" || @lt == "folder" || @lt == "pdf" || @lt == "视频" || @lt == "video" || @lt == "影片" || @lt == "movie" || @lt == "音频" || @lt == "audio" || @lt == "压缩" || @lt == "zip" || @lt == "archive" || @lt == "url" || @lt == "mail" || @lt == "vcard" || @lt == "contact" {
    @fileMark = "y"
}
@uploadURL = "{@endpoint}/upload/raw?room={@encodedRoom}&client=ios-shortcuts"
@isTextLike = "no"
if @lt == "文本" || @lt == "text" || @lt == "字符串" || @lt == "string" || @lt == "url" || @lt == "URL" {
    @isTextLike = "y"
}
if @fromInput && @isTextLike == "y" {
    @namedBody = setName(@item, "clipboard.txt")
    @response = rawUpload(@uploadURL, @namedBody, {"Authorization":"{@authorization}"})
} else if @fromInput {
    @uploadURL = "{@endpoint}/upload/raw?as=file&room={@encodedRoom}&client=ios-shortcuts"
    @response = rawUpload(@uploadURL, @item, {"Authorization":"{@authorization}"})
} else if @fileMark == "y" {
    @response = rawUpload(@uploadURL, @item, {"Authorization":"{@authorization}"})
} else {
    @namedBody = setName(@item, "clipboard.txt")
    @response = rawUpload(@uploadURL, @namedBody, {"Authorization":"{@authorization}"})
}
@record = getDictionary(@response)
@error = getValue(@record, "error")
if @error {
    @message = getValue(@record, "message")
    alert("发送失败：{@error}\n{@message}")
    stop()
}
@savedID = getValue(@record, "id")
if !@savedID {
    alert("服务器未确认保存，请检查部署地址及服务器状态。")
    stop()
}
@modelName = getDeviceDetail('Device Model')
@model = getText(@modelName)
if @model != "Mac" {
    vibrate()
}
show("已发送 {@savedID}")
