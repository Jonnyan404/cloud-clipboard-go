#define name Cloud-Clipboard-Send
#define inputs file, image, text, url, pdf
// 三个入口同时声明：iOS 分享菜单 + macOS Finder 快速操作 + macOS 菜单栏。
// 只写 sharesheet 的话，macOS 上不会出现在 Finder 右键的「快速操作」里，而那是 macOS 最自然的入口。
#define from sharesheet,quickactions,menubar
#define noinput getclipboard
#define color blue
#define version 26

#include 'actions/web'
#include 'actions/text'
#include 'actions/sharing'

// 导入时填写配置（也可之后在快捷指令顶部"文本"动作中修改）
#question qServerURL "服务器地址，例如 https://clip.example.com 或 http://127.0.0.1:9501" "http://127.0.0.1:9501"
#question qRoomName "房间名，多设备接收同一内容时使用相同房间；默认填 default" "default"
#question qRoomPassword "全局访问密码或房间密码；未设密码则留空" ""

// 服务器按内容魔数嗅探决定存为文本消息还是文件，客户端不做任何类型判断。
action 'downloadurl' rawUpload(text url: 'WFURL', variable body: 'WFRequestVariable', dictionary! headers: 'WFHTTPHeaders') {
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File"
}

@endpoint = text(qServerURL)
@room = text(qRoomName)
@password = text(qRoomPassword)
@endpoint = replaceText('^\s+|\s+$', '', @endpoint, true, true)
@endpoint = replaceText('/+$', "", @endpoint, true, true)
@room = replaceText('^\s+|\s+$', '', @room, true, true)
if !@room { @room = "default" }
if !@endpoint {
    alert("请先编辑快捷指令顶部的部署地址、房间名和密码。")
    stop()
}
@encodedRoom = urlEncode(@room)

// 2026-09-17 结构定死：两个来源完全分叉，互不共享新原语。
//   剪贴板路径 = 逐动作复刻 09-16 验收版（已实测仍可用，10:53 对照组）；
//   分享路径   = getName 判型（4th road：分享字符串的名字=内容首行，真文件保留文件名），
//                按名字里的扩展名匹配决定 as=file 与否，不调 getText、不用相等比较。
// 教训：凡是在剪贴板路径上引入 text() 转换、getName/getText、变量相等比较，
//       都会让 Shortcuts 抛"无法将文本转换为NSString"——它们只准出现在分享分支里。
@source = ShortcutInput
if !@source {
    // ── 剪贴板路径：与 09-16 验收版完全一致 ──
    @source = getClipboard()
    @amount = count(@source)
    if @amount != 1 {
        alert("请复制一条文字或一张图片后运行，或从分享菜单发送一个文件/一张照片。每次发送一项。")
        stop()
    }
    @item = getFirstItem(@source)
    @uploadURL = "{@endpoint}/upload/raw?room={@encodedRoom}&client=ios-shortcuts"
    @response = rawUpload(@uploadURL, @item, {"Authorization":"Bearer {@password}"})
} else {
    // ── 分享路径：getName 判型 ──
    @amount = count(@source)
    if @amount != 1 {
        alert("从分享菜单每次发送一项。")
        stop()
    }
    @item = getFirstItem(@source)
    // 判据（2026-09-17 实测，4th road）：
    //   · 系统字符串（剪贴板/URL scheme）的名字 = "Clipboard <日期>" → 当文本；
    //   · 右键选中文字等分享字符串的名字 = 内容首行 → beginsWith 命中 → 当文本；
    //   · 真文件保留自己的名字（getName 会把扩展名剥掉，如 rightclick.txt → rightclick）
    //     ，内容不以名为前缀 → as=file 保持文件。
    //   · 误判安全：图片/二进制即使被判成文本，服务端仍按魔数嗅探重新分流为文件。
    // getText/getName 只准在本分支使用——剪贴板条目上 getText 会抛"无法将文本转换为NSString"。
    @nmRaw = getName(@item)
    @nm = text(@nmRaw)
    if @nm contains "Clipboard " {
        @uploadURL = "{@endpoint}/upload/raw?room={@encodedRoom}&client=ios-shortcuts"
    } else {
        @tRaw = getText(@item)
        @t = text(@tRaw)
        if @t beginsWith @nm {
            @uploadURL = "{@endpoint}/upload/raw?room={@encodedRoom}&client=ios-shortcuts"
        } else {
            @uploadURL = "{@endpoint}/upload/raw?as=file&room={@encodedRoom}&client=ios-shortcuts"
        }
    }
    @response = rawUpload(@uploadURL, @item, {"Authorization":"Bearer {@password}"})
}
// cherri 的条件不能内联函数调用（会 panic），必须先落到变量

@record = getDictionary(@response)
@error = getValue(@record, "error")
if @error {
    @message = getValue(@record, "message")
    alert("发送失败：{@error}\n{@message}")
    stop()
}
@savedID = getValue(@record, "id")
if !@savedID {
    alert("服务器未确认保存，请检查部署地址及服务器状态。")
    stop()
}
// 用通知而不是 show()：show() 会在屏幕中央弹一张结果卡片，每次发送都打断视线；
// 通知只进通知中心。playSound 传 false，避免连续发送时反复响铃。
showNotification("已发送 {@savedID}", "Cloud Clipboard", false)
