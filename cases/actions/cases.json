      "params": {
        "mode": "phone",
        "with": "#"
      },
      "expect": "#1",
      "why": "替换模式没有词边界，会吞掉前 11 位"
    },
    {
      "id": "text.replace",
      "input": "从 192.168.1.1 来",
      "params": {
        "mode": "ip",
        "with": "***"
      },
      "expect": "从 *** 来"
    },
    {
      "id": "text.replace",
      "input": "A123",
      "params": {
        "mode": "digits",
        "with": ""
      },
      "expect": "A",
      "why": "with 留空 = 删除"
    },
    {
      "id": "text.replace",
      "input": "a$1b",
      "params": {
        "find": "$1",
        "with": "X"
      },
      "expect": "aXb",
      "why": "替换文本一律当字面，$1 不是组引用"
    },
    {
      "id": "text.replace",
      "input": "价格 12 元",
      "params": {
        "find": "12",
        "mode": "digits",
        "with": "$\u0026"
      },
      "expect": "价格 $\u0026 元",
      "why": "正则模式下的替换文本同样是字面（$\u0026 不该被展开）"
    },
    {
      "id": "zh.fullwidth",
      "input": "a b!",
      "expect": "ａ　ｂ！",
      "why": "0x20+0xFEE0 = U+FF00 是未分配字符，全角空格是 U+3000"
    },
    {
      "id": "zh.fullwidth",
      "input": "ＡＢ",
      "expect": "ＡＢ"
    },
    {
      "id": "zh.fullwidth",
      "input": "~",
      "expect": "～",
      "why": "0x7E 也是可见 ASCII，要转"
    },
    {
      "id": "zh.fullwidth",
      "input": "a\tb",
      "expect": "ａ\tｂ",
      "why": "制表符不在 0x21-0x7E 里，不动"
    },
    {
      "id": "zh.fullwidth",
      "input": "中文，。",
      "expect": "中文，。"
    },
    {
      "id": "zh.halfwidth",
      "input": "ａ　ｂ！",
      "expect": "a b!"
    },
    {
      "id": "zh.halfwidth",
      "input": "～",
      "expect": "~"
    },
    {
      "id": "zh.halfwidth",
      "input": "中文，。",
      "expect": "中文,。"
    },
    {
      "id": "zh.punctuation",
      "input": "你好，世界。",
      "expect": "你好,世界."
    },
    {
      "id": "zh.punctuation",
      "input": "（测试）「引用」",
      "expect": "(测试)\"引用\""
    },
    {
      "id": "zh.punctuation",
      "input": "『单』“双”‘单引’",
      "expect": "'单'\"双\"'单引'",
      "why": "四种引号两两成对映射到 \" 与 '"
    },
    {
      "id": "zh.punctuation",
      "input": "等等……然后——再看",
      "expect": "等等..然后--再看",
      "why": "双字符标点被拆成两个单字符（可接受）"
    },
    {
      "id": "zh.punctuation",
      "input": "全角空格　在标点里也换成半角",
      "expect": "全角空格 在标点里也换成半角",
      "why": "U+3000 也在表里"
    },
    {
      "id": "zh.number",
      "input": "10001",
      "expect": "一万零一"
    },
    {
      "id": "zh.number",
      "input": "10000",
      "expect": "一万"
    },
    {
      "id": "zh.number",
      "input": "10000001",
      "expect": "一千万零一"
    },
    {
      "id": "zh.number",
      "input": "10",
      "expect": "十"
    },
    {
      "id": "zh.number",
      "input": "0",
      "expect": "零"
    },
    {
      "id": "zh.number",
      "input": "-12.5",
      "expect": "负十二点五"
    },
    {
      "id": "zh.number",
      "input": "100000000",
      "expect": "一亿",
      "why": "亿"
    },
    {
      "id": "zh.number",
      "input": "11",
      "expect": "十一",
      "why": "十一（不是一十一）"
    },
    {
      "id": "zh.number",
      "input": "20",
      "expect": "二十",
      "why": "二十（「一十」只在整串开头才省）"
    },
    {
      "id": "zh.number",
      "input": "1.05",
      "expect": "一点零五",
      "why": "小数逐位念，零要念出来"
    },
    {
      "id": "zh.number",
      "input": "007",
      "expect": "七",
      "why": "前导零丢掉"
    },
    {
      "id": "zh.number",
      "input": "0.5",
      "expect": "零点五"
    },
    {
      "id": "zh.number",
      "input": "1234567890123456",
      "expect": "一千二百三十四万亿五千六百七十八亿九千零一十二万三千四百五十六",
      "why": "四节到底（万亿）"
    },
    {
      "id": "zh.number",
      "input": "",
      "error": true
    },
    {
      "id": "zh.number",
      "input": "+12",
      "error": true,
      "why": "不认加号"
    },
    {
      "id": "zh.number",
      "input": "1e3",
      "error": true,
      "why": "不认科学计数法"
    },
    {
      "id": "zh.number",
      "input": "１２３",
      "error": true,
      "why": "全角数字不是 \\d"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 +1d",
      "expect": "2026-09-25"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 +1w",
      "expect": "2026-10-01"
    },
    {
      "id": "date.add",
      "input": "2026-01-31 +1m",
      "expect": "2026-02-28",
      "why": "月末溢出要夹到当月最后一天"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 +1y",
      "expect": "2027-09-24"
    },
    {
      "id": "date.add",
      "input": "2024-02-29 +1y",
      "expect": "2025-02-28",
      "why": "闰日 +1 年 → 夹到 2/28"
    },
    {
      "id": "date.add",
      "input": "-1d",
      "expect": "2026-09-23",
      "why": "省略基准 = ctx.Now 的日期"
    },
    {
      "id": "date.add",
      "input": "今天 +1d",
      "expect": "2026-09-25",
      "why": "今天 = ctx.Now 的日期"
    },
    {
      "id": "date.add",
      "input": "明天 +1d",
      "expect": "2026-09-26",
      "why": "关键词先归零点再加偏移"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 10:30 +2d",
      "expect": "2026-09-26 10:30",
      "why": "基准带时间则结果保留时间"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 10:30:07 +1d",
      "expect": "2026-09-25 10:30",
      "why": "带秒也按分钟输出（秒被丢掉）"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 +3",
      "expect": "2026-09-27",
      "why": "不写单位按天"
    },
    {
      "id": "date.add",
      "input": "  2026-09-24   +   1d  ",
      "expect": "2026-09-25",
      "why": "运算符两侧的空格都允许"
    },
    {
      "id": "date.add",
      "input": "2026-9-24 +1d",
      "expect": "2026-09-25",
      "why": "月/日可以是一位数"
    },
    {
      "id": "date.add",
      "input": "2026/09/24 +1d",
      "expect": "2026-09-25"
    },
    {
      "id": "date.add",
      "input": "20260924 +1d",
      "expect": "2026-09-25",
      "why": "紧凑写法（曾是下标越界 panic 的那条路）"
    },
    {
      "id": "date.add",
      "input": "2026年09月24日 +1d",
      "expect": "2026-09-25"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 +1D",
      "error": true,
      "why": "单位只认小写"
    },
    {
      "id": "date.add",
      "input": "不是日期 +1d",
      "error": true
    },
    {
      "id": "date.add",
      "input": "2026-02-31 +1d",
      "error": true,
      "why": "回读校验：不存在的日期要报错，不能被悄悄滚到 3 月"
    },
    {
      "id": "date.add",
      "input": "2026-09-24 加一天",
      "error": true
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 ~ 2026-03-15",
      "expect": "73 天\n10 周 3 天"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01\n2026-03-15",
      "expect": "73 天\n10 周 3 天",
      "why": "两行写法等价"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 至 2026-01-08",
      "expect": "7 天\n1 周 0 天",
      "why": "「周 0 天」也要写出来（只要周数 \u003e 0）"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01～2026-03-15",
      "expect": "73 天\n10 周 3 天",
      "why": "全角波浪号"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 -\u003e 2026-03-15",
      "expect": "73 天\n10 周 3 天"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 ~ 2026-01-04",
      "expect": "3 天",
      "why": "不足一周只出一行"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 ~ 2026-01-01",
      "expect": "0 天",
      "why": "同一天 = 0 天"
    },
    {
      "id": "date.diff",
      "input": "2026-03-15 ~ 2026-01-01",
      "expect": "-73 天\n10 周 3 天",
      "why": "倒序：天为负、周取绝对值"
    },
    {
      "id": "date.diff",
      "input": "2026-01-01 23:00 ~ 2026-01-02 01:00",
      "expect": "1 天",
      "why": "按本地零点算差，不是时刻差"
    },
    {
      "id": "date.diff",
      "input": "只有一行",
      "error": true
    },
    {
      "id": "date.diff",
      "input": "2026-02-31 ~ 2026-03-15",
      "error": true,
      "why": "任一侧认不出就报错"
    }
